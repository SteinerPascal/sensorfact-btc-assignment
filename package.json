{
  "name": "backend-assignment-btcenergy",
  "version": "1.0.0",
  "description": "Sensorfact back-end developer assignment",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "start": "serverless offline start --httpPort=4000 --host 0.0.0.0 --reloadHandler",
    "compile": "tsc -p . --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,yml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,yml}\"",
    "test": "jest",
    "test:watch": "jest --watch --onlyChanged",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v",
    "backfill": "tsx src/backfill/index.ts",
    "worker:once": "tsx src/worker/local.ts",
    "retention:once": "tsx src/retention/local.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@opentelemetry/sdk-trace-node": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "graphql": "^16.10.0",
    "graphql-scalars": "^1.24.0",
    "graphql-yoga": "^5.10.11",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/aws-lambda": "^8.10.80",
    "@types/jest": "^29.5.14",
    "@types/node": "20.x",
    "@types/pg": "^8.11.10",
    "@types/serverless": "^3",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "jest": "^29.0.2",
    "prettier": "^3.4.2",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.57.0",
    "serverless-offline": "^13.9.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.20.0"
  }
}
